[user]
        name       = "{{ user.name }}"
        email      = "{{ user.email }}"
        signingkey = "{{ user.email }}"

[commit]
        gpgSign = true

[tag]
        gpgSign = true

[push]
        gpgSign = if-asked

[merge]
        tool = nvimdiff

[mergetool]
        keepBackup = false
        prompt     = false

[mergetool.nvimdiff]
        layout = "LOCAL,REMOTE/MERGED"
